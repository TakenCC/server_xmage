				{
					"name": "Observar Mesa",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/tables/{{tableId}}/watch?roomId={{roomId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tables",
								"{{tableId}}",
								"watch"
							],
							"query": [
								{
									"key": "roomId",
									"value": "{{roomId}}"
								}
							]
						},
						"description": "Observa una mesa sin unirse"
					},
					"response": []
				},
				{
					"name": "Es Dueño de Mesa",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/tables/{{tableId}}/is-owner?roomId={{roomId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tables",
								"{{tableId}}",
								"is-owner"
							],
							"query": [
								{
									"key": "roomId",
									"value": "{{roomId}}"
								}
							]
						},
						"description": "Verifica si el usuario es dueño de la mesa"
					},
					"response": []
				},
				{
					"name": "Eliminar Mesa",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/tables/{{tableId}}?roomId={{roomId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tables",
								"{{tableId}}"
							],
							"query": [
								{
									"key": "roomId",
									"value": "{{roomId}}"
								}
							]
						},
						"description": "Elimina una mesa (solo si eres dueño)"
					},
					"response": []
				}
			]
		},
		{
			"name": "Juegos (Games)",
			"item": [
				{
					"name": "Obtener Estado del Juego",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var game = pm.response.json();",
									"    if (game.gameId) {",
									"        pm.collectionVariables.set('gameId', game.gameId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/games/{{gameId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"games",
								"{{gameId}}"
							]
						},
						"description": "Obtiene el estado actual de un juego"
					},
					"response": []
				},
